BOT_TOKEN=1234567890:PASTE_TELEGRAM_BOT_TOKEN_HERE
ADMIN_IDS=111111111,222222222
DATABASE_PATH=data/nhl_bot.sqlite3
START_COINS=0
START_ENERGY=0
START_RANK_POINTS=0

# Опционально: куда писать временный кэш рендера карточек. По умолчанию /app/cache —
# ВНЕ Railway Volume (пересоздаётся при каждом деплое, не занимает постоянное место).
# Не указывать путь внутри data/ — раздел 12 ТЗ по надёжности требует держать
# render_cache вне persistent Volume.
# RENDER_CACHE_PATH=/app/cache/render_cache

# Railway подставляет автоматически (используются командой /version):
# RAILWAY_GIT_COMMIT_SHA=
# RAILWAY_ENVIRONMENT_NAME=

# FINAL PRODUCTION DEPLOY SAFETY (Railway)
# Keep the Railway Volume mounted at /app/data.
# DATABASE_PATH=/app/data/nhl_bot.sqlite3
# STRICT_PERSISTENT_STORAGE=1
# ALLOW_EMPTY_DATABASE=0
# REQUIRE_EXISTING_UPLOADS=1
# VERIFY_UPLOADS_ON_BOOT=1
# REQUIRE_PREDEPLOY_BACKUP=1
# STRICT_DB_INTEGRITY=1
